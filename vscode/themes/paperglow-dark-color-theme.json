    "welcomePage.progress.foreground": "#D59A6F"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9E9489",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A8B88F"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D59A6F"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8EC3B4"
      }
    },
    {
      "name": "Types and Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#C6A7E1"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "identifier",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#BDB1A4"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#DDBA73"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#B6AA9E"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E0A477",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#D9B36A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Quotes",
      "scope": [
        "markup.quote",
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#B6AA9E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown and Inline Code",
      "scope": [
        "markup.inline.raw",
        "markup.raw.block",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#F0C796"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E07A72",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#C6A7E1",
    "enum": "#C6A7E1",
    "function": "#8EC3B4",
    "interface": "#C6A7E1",
    "keyword": "#D59A6F",
    "method": "#8EC3B4",
    "namespace": "#DDBA73",
    "parameter": "#B6AA9E",
    "property": "#B6AA9E",
    "string": "#A8B88F",
    "type": "#C6A7E1",
    "variable": "#BDB1A4"
  }
}
