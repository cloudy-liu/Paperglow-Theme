  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8A7D72",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#5E7E5A"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#A85F35"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#2F7568"
      }
    },
    {
      "name": "Types and Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": {
        "foreground": "#7B5E9E"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "identifier", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#3B3028"
      }
    },
    {
      "name": "Constants",
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#8D6D2F"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#7B6F64"
      }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": {
        "foreground": "#A85F35",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Links",
      "scope": ["markup.underline.link", "string.other.link", "markup.underline.link.markdown"],
      "settings": {
        "foreground": "#8B5D30",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown Quotes",
      "scope": ["markup.quote", "markup.quote.markdown"],
      "settings": {
        "foreground": "#74695F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown and Inline Code",
      "scope": ["markup.inline.raw", "markup.raw.block", "markup.fenced_code.block.markdown"],
      "settings": {
        "foreground": "#8A4F32"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#A6403A",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#7B5E9E",
    "enum": "#7B5E9E",
    "function": "#2F7568",
    "interface": "#7B5E9E",
    "keyword": "#A85F35",
    "method": "#2F7568",
    "namespace": "#8D6D2F",
    "parameter": "#5D5047",
    "property": "#5D5047",
    "string": "#5E7E5A",
    "type": "#7B5E9E",
    "variable": "#3B3028"
  }
}
